# Copy this file to `.env` (never commit `.env`) and fill in the two values.
# Both come from Supabase → Project Settings → API (or "API Keys").

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
# Do not append /rest/v1; the Supabase client adds it automatically.
VITE_SUPABASE_URL=

# The PUBLISHABLE key (starts with sb_publishable_...) or the legacy "anon" public key.
# This key is safe in the browser because Row Level Security protects your data.
# NEVER put the service_role / secret key in any VITE_ variable — Vite ships them to every visitor.
VITE_SUPABASE_PUBLISHABLE_KEY=


